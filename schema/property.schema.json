{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/property.schema.json",
  "title": "Property",
  "description": "A fictional property listing record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "property_id", "address", "price", "bedrooms", "bathrooms",
    "square_feet", "amenities", "local_sponsors"
  ],
  "properties": {
    "property_id": {
      "type": "string",
      "pattern": "^PROP-[0-9]{4}$",
      "description": "Primary key, e.g. PROP-0001"
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["street", "city", "state", "zip_code"],
      "properties": {
        "street":   { "type": "string", "minLength": 3 },
        "unit":     { "type": "string", "minLength": 1 },
        "city":     { "type": "string", "minLength": 2 },
        "state":    { "type": "string", "pattern": "^[A-Z]{2}$" },
        "zip_code": { "type": "string", "pattern": "^[0-9]{5}(-[0-9]{4})?$" }
      }
    },
    "price":       { "type": "integer", "minimum": 0 },
    "bedrooms":    { "type": "integer", "minimum": 0, "maximum": 20 },
    "bathrooms":   { "type": "number", "minimum": 0, "maximum": 20, "multipleOf": 0.5 },
    "square_feet": { "type": "integer", "minimum": 1 },
    "amenities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "pool", "garage", "fireplace", "hardwood_floors", "central_air",
          "garden", "balcony", "in_unit_laundry", "fitness_center", "pet_friendly"
        ]
      }
    },
    "local_sponsors": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/sponsor" }
    }
  },
  "$defs": {
    "sponsor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sponsor_id", "name", "category", "placement"],
      "properties": {
        "sponsor_id": { "type": "string", "pattern": "^SPN-[0-9]{3}$" },
        "name":       { "type": "string", "minLength": 2 },
        "category": {
          "type": "string",
          "enum": ["mortgage", "inspection", "moving", "insurance", "landscaping", "other"]
        },
        "website":   { "type": "string", "format": "uri" },
        "placement": { "type": "string", "enum": ["primary", "secondary"] }
      }
    }
  }
}